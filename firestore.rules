rules_version = '2';

// Simple test rules for the CHS Blood Drive prototype.
// These rules intentionally keep the client code unblocked while the app is
// being tested. Tighten these before collecting real student information.
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{registrationId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /slotCounts/{slotDocId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && adminId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
